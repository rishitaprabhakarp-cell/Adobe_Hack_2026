    {
      "path": "/pricing",
      "url": "https://stripe.com/pricing",
      "status": 200,
      "error": null,
      "jsonld_blocks": [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "url": "https://stripe.com/in/pricing",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How are payment fees calculated?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Stripe charges a per-transaction fee depending on the payment method used by the end customer. More details on fees by payment method."
              }
            },
            {
              "@type": "Question",
              "name": "Will I be charged tax?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Stripe is required to charge tax on certain products and services. Tax is charged based on your location and/ or your business/tax status, which determines whether a product or service is subject to taxes, and the applicable tax rates.\n\nRead more"
              }
            },
            {
              "@type": "Question",
              "name": "Are there additional fees for refunds?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "- For businesses on standard pricing: There may be fees for refunds when bank transfers are used. For all other payment methods, there are no fees for issuing refunds. The payment processing, Connect and currency conversion fees from the original transaction are not returned.\n- For businesses on custom pricing: There may be fees for issuing refunds depending on your fee schedule with Stripe."
              }
            },
            {
              "@type": "Question",
              "name": "Do you have setup fees or monthly fees?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Stripe does not charge setup fees, monthly fees, or any other hidden fees like closure fees. All fees for businesses on standard pricing are listed on our website."
              }
            },
            {
              "@type": "Question",
              "name": "Do you offer any discounts?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Stripe offers custom pricing for businesses with large processing volumes. Eligibility varies by market."
              }
            }
          ]
        }
      ],
